{
  "name": "@local/dsh-session-header",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness Host bundle: inject x-opencode-session (the current DSH session id) on LLM gateway requests for CPA / OpenCode Go routing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azincc/dsh-opencode-session-header.git"
  },
  "homepage": "https://github.com/Azincc/dsh-opencode-session-header",
  "bugs": {
    "url": "https://github.com/Azincc/dsh-opencode-session-header/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm",
    "opencode",
    "session-header"
  ],
  "scripts": {
    "test": "node verify-local.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "verify-local.mjs",
    "locale/*.json",
    "docs",
    "examples",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
